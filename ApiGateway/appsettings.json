{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "post-route": {
        "ClusterId": "post-cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "topic-route": {
        "ClusterId": "topic-cluster",
        "Match": {
          "Path": "/api/topics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7222"
          }
        }
      },
      "post-cluster": {
        "Destinations": {
          "destination1": { 
            "Address": "https://localhost:7231"
          }
        }
      },
      "topic-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7068"
          }
        }
      }
    }
  }
}